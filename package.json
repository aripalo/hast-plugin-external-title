{
  "name": "hast-plugin-external-title",
  "version": "1.0.0",
  "description": "Sätteri hast plugin that fetches the page title of external links and sets it as the `title` attribute, with pluggable caching.",
  "license": "MIT",
  "author": {
    "name": "Ari Palo",
    "email": "opensource@aripalo.com",
    "url": "https://aripalo.technology"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "default": "./dist/cache/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || ^26.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "cheerio": "^1.2.0",
    "isomorphic-dompurify": "^3.22.0",
    "lowdb": "^7.0.1"
  },
  "peerDependencies": {
    "satteri": "^0.10.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "npm": "^11.19.0",
    "satteri": "^0.10.5",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "satteri",
    "satteri-plugin",
    "hast",
    "hast-plugin",
    "astro",
    "markdown",
    "html",
    "external-links",
    "title",
    "metadata",
    "link-title",
    "tooltip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aripalo/hast-plugin-external-title.git"
  },
  "bugs": {
    "url": "https://github.com/aripalo/hast-plugin-external-title/issues",
    "email": "opensource@aripalo.com"
  },
  "homepage": "https://github.com/aripalo/hast-plugin-external-title#readme"
}
