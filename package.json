{
  "name": "rehype-external-link-title",
  "version": "0.1.0",
  "description": "rehype plugin that fetches the page title of external links and sets it as the `title` attribute, with pluggable caching.",
  "license": "MIT",
  "author": {
    "name": "Ari Palo",
    "email": "opensource@aripalo.com",
    "url": "https://aripalo.technology"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "default": "./dist/cache/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "isomorphic-dompurify": "^2.36.0",
    "lowdb": "^7.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "unified": ">=11"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "unified": "^11.0.5",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "rehype",
    "rehype-plugin",
    "unified",
    "html",
    "hast",
    "external-links",
    "title",
    "metadata",
    "link-title",
    "tooltip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aripalo/rehype-external-link-title.git"
  },
  "bugs": {
    "url": "https://github.com/aripalo/rehype-external-link-title/issues",
    "email": "opensource@aripalo.com"
  },
  "homepage": "https://github.com/aripalo/rehype-external-link-title#readme"
}
